# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Only the names live here; there are no real values in this file.

# Public address of the app, used in invitation links (no trailing slash).
# Local development: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Supabase (Project settings, API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never put this in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only.
CLERK_SECRET_KEY=

# Landing-only mode. Set to true on the hosted site while the app is under
# development: only the landing page is served and sign-in is closed.
# Leave unset locally and everywhere else.
LANDING_ONLY=

# Signed-in browser tests (npm run test:e2e). Four test users, made by hand in
# the Clerk development instance with +clerk_test emails (no password needed; the
# tests sign in with Clerk's testing tokens). The seed writes only rows named
# "E2E" to the database above, and refuses an email without +clerk_test.
E2E_COORDINATOR_EMAIL=
E2E_SUPERVISOR_OWNER_EMAIL=
E2E_SUPERVISOR_EMAIL=
E2E_STUDENT_EMAIL=
